// Despliegue en Cloudflare Workers como sitio estático: no hay código de servidor,
// solo se sirve lo que genera `npm run build` en dist/.
{
  "name": "tinkersignals",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
